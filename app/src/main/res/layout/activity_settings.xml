<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки"
            android:textColor="#ECECF1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API-ключ Kimi (Moonshot)"
            android:textColor="#8A8A98"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:textColorHint="#6F6F7C"
            android:textColor="#ECECF1"
            android:inputType="text"
            android:maxLines="1"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:padding="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Адрес API (для Китая — api.moonshot.cn/v1)"
            android:textColor="#8A8A98"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ECECF1"
            android:inputType="textUri"
            android:maxLines="1"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:padding="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Модель"
            android:textColor="#8A8A98"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ECECF1"
            android:inputType="text"
            android:maxLines="1"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input"
            android:padding="14dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить"
            android:backgroundTint="@color/accent"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Очистить историю чата"
            android:backgroundTint="#2A2A38"
            android:textColor="#ECECF1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ключ можно получить на platform.moonshot.ai (или platform.moonshot.cn для Китая). Приложение совместимо с любым OpenAI-совместимым API: поменяй адрес и модель."
            android:textColor="#6F6F7C"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
