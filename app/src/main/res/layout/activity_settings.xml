<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки"
            android:textColor="#ECECF1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Бесплатный ИИ — в один тап"
            android:textColor="#9E9ECF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnGemini"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Gemini 🆓"
                android:textSize="12sp"
                android:backgroundTint="#2A2A38"
                android:textColor="#8FE38F" />

            <Button
                android:id="@+id/btnOpenRouter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="OpenRouter 🆓"
                android:textSize="12sp"
                android:backgroundTint="#2A2A38"
                android:textColor="#8FE38F" />

            <Button
                android:id="@+id/btnKimi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kimi"
                android:textSize="12sp"
                android:backgroundTint="#2A2A38"
                android:textColor="#B9B9E6" />
        </LinearLayout>

        <Button
            android:id="@+id/btnFreeKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🆓 Получить бесплатный ключ (Google AI Studio)"
            android:textAllCaps="false"
            android:backgroundTint="#1E3A1E"
            android:textColor="#8FE38F" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API-ключ"
            android:textColor="#8A8A98"
            android:textSize="13sp"
            android:layout_marginTop="14dp" />

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:textColorHint="#6F6F7C"
            android:textColor="#ECECF1"
            android:inputType="text"
            android:maxLines="1"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input"
            android:padding="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Адрес API"
            android:textColor="#8A8A98"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ECECF1"
            android:inputType="textUri"
            android:maxLines="1"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input"
            android:padding="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Модель"
            android:textColor="#8A8A98"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ECECF1"
            android:inputType="text"
            android:maxLines="1"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:padding="14dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить"
            android:backgroundTint="@color/accent"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Открывать как Google Ассистент"
            android:textColor="#9E9ECF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Назначь Кими цифровым помощником — и жест (долгое нажатие «Домой» или свайп из нижнего угла) будет открывать Кими поверх любого приложения, с авто-включением микрофона."
            android:textColor="#6F6F7C"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAssist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🛠 Назначить помощником по умолчанию"
            android:textAllCaps="false"
            android:backgroundTint="#2A2A38"
            android:textColor="#ECECF1" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Очистить историю чата"
            android:backgroundTint="#2A2A38"
            android:textColor="#ECECF1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Gemini: ключ с aistudio.google.com/apikey — бесплатно, без карты (Flash-модели). Kimi: platform.moonshot.ai, новым аккаунтам стартовые кредиты, для Китая — api.moonshot.cn/v1. OpenRouter: openrouter.ai — модели «:free» бесплатны. Приложение работает с любым OpenAI-совместимым API."
            android:textColor="#6F6F7C"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
